###############################################################################
# ROS Noetic from source — multi-stage Docker build (Ubuntu 24.04)
#
# Build targets:
#   docker build -f Dockerfile.24_04 --target devel   -t ros-noetic:devel   .
#   docker build -f Dockerfile.24_04 --target runtime -t ros-noetic:runtime .
#
# 'devel'   — build tools + ROS core, for compiling your own packages on top
# 'runtime' — minimal, just enough to run ROS nodes
#
# Workflow for your own packages:
#   1. Use ros-noetic:devel as the base to compile your catkin workspace
#   2. COPY the result into ros-noetic:runtime for deployment
###############################################################################

# =============================================================================
# Stage 1: Build ROS Noetic from source
# =============================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

WORKDIR /ros_from_src
COPY dependencies.sh git_clone.sh build.sh ./

# ca-certificates is needed for HTTPS git clones and not in dependencies.sh
RUN apt-get update && apt-get install -y ca-certificates \
    && ./dependencies.sh \
    && rm -rf /var/lib/apt/lists/*

# Clone repos (from the build directory, as per README)
RUN mkdir build
WORKDIR /ros_from_src/build
RUN ../git_clone.sh

# Build orocos_kdl (needed by tf2_kdl and geometry packages)
ENV OROCOS_PREFIX=/opt/orocos/noetic
RUN git clone --depth 1 https://github.com/orocos/orocos_kinematics_dynamics.git \
    && cd orocos_kinematics_dynamics/orocos_kdl \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=${OROCOS_PREFIX} \
    && make -j$(nproc) && make install

# Build ROS — build.sh defaults to /opt/ros/noetic
RUN ../build.sh

# Discover which system packages provide the shared libraries that
# the built ROS binaries link against. Used by the runtime stage.
# ldd reports paths under /lib/ but dpkg indexes under /usr/lib/ (they are
# symlinked on Ubuntu 24.04). Canonicalize with readlink before querying dpkg.
ENV DEST=/opt/ros/noetic
RUN export LD_LIBRARY_PATH=${DEST}/lib:${OROCOS_PREFIX}/lib:${LD_LIBRARY_PATH} \
    && { find ${DEST}/lib ${OROCOS_PREFIX}/lib -maxdepth 1 \( -name '*.so' -o -name '*.so.*' \); \
         find ${DEST}/bin -maxdepth 1 -type f -executable; } \
    | xargs ldd 2>/dev/null \
    | grep -oP '(?<==> )(/usr)?/lib/\S+' \
    | sort -u \
    | xargs readlink -f \
    | sort -u \
    | xargs dpkg -S 2>/dev/null \
    | cut -d: -f1 \
    | sort -u \
    > /tmp/runtime-lib-packages.txt \
    && echo "Runtime packages:" && cat /tmp/runtime-lib-packages.txt


# =============================================================================
# Stage 2: Development image — build your own ROS packages against this
# =============================================================================
FROM ubuntu:24.04 AS devel

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

COPY dependencies.sh /tmp/
RUN apt-get update && apt-get install -y ca-certificates \
    && /tmp/dependencies.sh \
    && rm /tmp/dependencies.sh \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/ros/noetic /opt/ros/noetic
COPY --from=builder /opt/orocos/noetic /opt/orocos/noetic

ENV CMAKE_PREFIX_PATH=/opt/orocos/noetic:/opt/ros/noetic
ENV PATH=/opt/ros/noetic/bin:${PATH}

RUN echo 'source /opt/ros/noetic/setup.bash' >> /etc/bash.bashrc

WORKDIR /catkin_ws


# =============================================================================
# Stage 3: Minimal runtime — just enough to run ROS nodes
# =============================================================================
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Runtime shared libraries discovered by ldd in the builder, plus Python.
COPY --from=builder /tmp/runtime-lib-packages.txt /tmp/runtime-lib-packages.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python-is-python3 \
       python3 \
       python3-dateutil \
       python3-defusedxml \
       python3-distro \
       python3-empy \
       python3-gnupg \
       python3-netifaces \
       python3-pycryptodome \
       python3-pyparsing \
       python3-setuptools \
       python3-yaml \
    && xargs apt-get install -y --no-install-recommends < /tmp/runtime-lib-packages.txt \
    && rm /tmp/runtime-lib-packages.txt \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/ros/noetic /opt/ros/noetic
COPY --from=builder /opt/orocos/noetic /opt/orocos/noetic

ENV PATH=/opt/ros/noetic/bin:${PATH}

RUN echo 'source /opt/ros/noetic/setup.bash' >> /etc/bash.bashrc
